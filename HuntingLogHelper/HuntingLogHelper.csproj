<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <!-- Bump the SDK version above to match the current Dalamud API level when it changes. -->
  <PropertyGroup>
    <Version>0.2.2.0</Version>
    <Description>Works through your class hunting log automatically.</Description>
    <PackageProjectUrl>https://github.com/DevilBike/hlh</PackageProjectUrl>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Embedded so the data ships inside the DLL (the release zip only carries the DLL and manifest). -->
    <None Remove="Data\*.json" />
    <EmbeddedResource Include="Data\*.json" LogicalName="HuntingLogHelper.Data.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
